# Aponta pro MESMO PostgreSQL que a sprint2-RPA sobe via docker compose
# (db/init.sql de lá cria as tabelas ativo/tag/leitura_sensor; o Pilar 2
# desta sprint só adiciona a tabela evento_alerta e atualiza tag.status).
# Copie pra .env e ajuste se o .env da sprint2-RPA usar valores diferentes.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=digital_twin
DB_USER=postgres
DB_PASSWORD=postgres
